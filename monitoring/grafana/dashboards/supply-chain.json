      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(forecast_api_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(forecast_api_requests_total[5m])), 1e-9)",
          "legendFormat": "forecast-api",
          "range": true
