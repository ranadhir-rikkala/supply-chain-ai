        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"platform-api\", status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"platform-api\"}[5m])), 1e-9)",
          "legendFormat": "platform-api",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
