            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100 * (metrics->'weekly'->>'baseline_wape')::float AS \"Seasonal naive\" FROM ml.model_version WHERE status = 'ACTIVE'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
