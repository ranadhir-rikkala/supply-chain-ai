    {
      "id": 15,
      "type": "barchart",
      "title": "ETL rows loaded vs quarantined per feed day",
      "description": "Rows accepted and rows quarantined by the ETL for the 30 most recent feed days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT feed_day, loaded, quarantined FROM ( SELECT to_char(feed_date, 'YYYY-MM-DD') AS feed_day, feed_date, sum(good_count) AS loaded, sum(bad_count) AS quarantined FROM ops.etl_file WHERE feed_date IS NOT NULL GROUP BY feed_date ORDER BY feed_date DESC LIMIT 30) recent ORDER BY feed_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "loaded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "quarantined"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "feed_day",
        "orientation": "vertical",
        "stacking": "normal",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "showValue": "auto",
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "barchart",
      "title": "Model weekly WAPE vs seasonal naive",
      "description": "Weekly WAPE on the backtest for the ten newest model versions. The gate line is 25%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model, \"model WAPE\", \"seasonal naive\" FROM ( SELECT model_version || CASE WHEN status = 'ACTIVE' THEN ' (active)' ELSE '' END AS model, created_at, round(100 * (metrics->'weekly'->>'wape')::numeric, 1) AS \"model WAPE\", round(100 * (metrics->'weekly'->>'baseline_wape')::numeric, 1) AS \"seasonal naive\" FROM ml.model_version ORDER BY created_at DESC LIMIT 10) recent ORDER BY created_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "model WAPE"
            },
            "properties": [
